{
  "id": "const_main",
  "name": "ConST 检定主循环",
  "description": "康斯特压力表全自动检定的主流程：连 MQTT 发现检定系统 → 搬料箱 → 逐个工位装表（装表细节在子流程 const_install_station 里）→ 请求启动检定 → 按检定结果重装或拆表 → 下料。这是本项目唯一的入口流程，PROCESS_BEGINS 跑的就是它。",
  "start": "n_mqtt",
  "enabled": true,
  "nodes": [
    {
      "id": "n_mqtt",
      "type": "const_mqtt_connect",
      "label": "连接MQTT并发现检定系统",
      "params": {},
      "x": 80,
      "y": 80
    },
    {
      "id": "n_mqtt_delay",
      "type": "delay",
      "label": "MQTT重连等待",
      "params": {
        "seconds": 3
      },
      "x": 80,
      "y": 240
    },
    {
      "id": "n_bind",
      "type": "const_wait_calsys",
      "label": "等待检定系统绑定本机",
      "params": {
        "want": "bound",
        "timeout": 0
      },
      "x": 360,
      "y": 80
    },
    {
      "id": "n_status",
      "type": "const_set_live",
      "label": "上报待机",
      "params": {
        "status": "待机"
      },
      "x": 640,
      "y": 80
    },
    {
      "id": "n_nav_in",
      "type": "navigate",
      "label": "导航到来料货架",
      "params": {
        "robot_id": "robot_a",
        "pose": "inbound_shelf",
        "skip_if_at_pose": true,
        "timeout": 180
      },
      "x": 920,
      "y": 80
    },
    {
      "id": "n_plc",
      "type": "const_plc_ready",
      "label": "检查PLC就绪",
      "params": {},
      "x": 1200,
      "y": 80
    },
    {
      "id": "n_plc_delay",
      "type": "delay",
      "label": "PLC未就绪等待",
      "params": {
        "seconds": 5
      },
      "x": 1200,
      "y": 240
    },
    {
      "id": "n_pick",
      "type": "send_operation",
      "label": "搬箱子",
      "params": {
        "call_type": "service",
        "service": "robot_task",
        "robot_id": "robot_a",
        "task": "pick_up_box",
        "area": "inbound_shelf",
        "timeout": 1200
      },
      "x": 1480,
      "y": 80
    },
    {
      "id": "n_parse",
      "type": "const_parse_box",
      "label": "解析是否有箱/表数量",
      "params": {},
      "x": 1760,
      "y": 80
    },
    {
      "id": "n_has_box",
      "type": "condition",
      "label": "箱子里有表?",
      "params": {
        "var": "has_box",
        "op": "truthy",
        "value": ""
      },
      "x": 2040,
      "y": 80
    },
    {
      "id": "n_pick_delay",
      "type": "delay",
      "label": "无箱，过几秒再搬",
      "params": {
        "seconds": 5
      },
      "x": 1760,
      "y": 240
    },
    {
      "id": "n_wait_idle",
      "type": "const_wait_calsys",
      "label": "等待检定系统空闲",
      "params": {
        "want": "idle",
        "timeout": 0
      },
      "x": 80,
      "y": 420
    },
    {
      "id": "n_pick_st",
      "type": "const_pick_station",
      "label": "选待装表工位",
      "params": {},
      "x": 360,
      "y": 420
    },
    {
      "id": "n_install",
      "type": "sub_flow",
      "label": "装表并等识别/检漏",
      "params": {
        "flow": "const_install_station"
      },
      "x": 640,
      "y": 420
    },
    {
      "id": "n_has_inst",
      "type": "condition",
      "label": "本轮已装上工位?",
      "params": {
        "var": "installed_stations",
        "op": "truthy",
        "value": ""
      },
      "x": 360,
      "y": 600
    },
    {
      "id": "n_remain_wait",
      "type": "condition",
      "label": "还有表没放?",
      "params": {
        "var": "remaining",
        "op": ">",
        "value": 0
      },
      "x": 640,
      "y": 600
    },
    {
      "id": "n_st_delay",
      "type": "delay",
      "label": "等工位空出来",
      "params": {
        "seconds": 5
      },
      "x": 920,
      "y": 600
    },
    {
      "id": "n_start",
      "type": "const_mqtt_start",
      "label": "请求启动检定",
      "params": {},
      "x": 920,
      "y": 420
    },
    {
      "id": "n_wait_end",
      "type": "const_wait_end",
      "label": "等待检定结束通知",
      "params": {
        "timeout": 0
      },
      "x": 1200,
      "y": 420
    },
    {
      "id": "n_leak",
      "type": "condition",
      "label": "发生泄漏?",
      "params": {
        "var": "end_is_leak",
        "op": "truthy",
        "value": ""
      },
      "x": 1480,
      "y": 420
    },
    {
      "id": "n_reinstall",
      "type": "const_reinstall_all",
      "label": "全部工位重装",
      "params": {
        "timeout": 1200
      },
      "x": 1480,
      "y": 600
    },
    {
      "id": "n_normal",
      "type": "condition",
      "label": "正常结束?",
      "params": {
        "var": "end_is_normal",
        "op": "truthy",
        "value": ""
      },
      "x": 1760,
      "y": 420
    },
    {
      "id": "n_pending",
      "type": "const_wait_calsys",
      "label": "等待人工确认结束",
      "params": {
        "want": "pending_clear",
        "timeout": 0
      },
      "x": 1760,
      "y": 600
    },
    {
      "id": "n_uninst",
      "type": "const_uninstall_all",
      "label": "按合格/不合格拆表",
      "params": {
        "timeout": 1200
      },
      "x": 2040,
      "y": 420
    },
    {
      "id": "n_more",
      "type": "condition",
      "label": "箱内还有未放的表?",
      "params": {
        "var": "remaining",
        "op": ">",
        "value": 0
      },
      "x": 2320,
      "y": 420
    },
    {
      "id": "n_nav_out",
      "type": "navigate",
      "label": "导航到下料货架",
      "params": {
        "robot_id": "robot_a",
        "pose": "outbound_shelf",
        "skip_if_at_pose": true,
        "timeout": 180
      },
      "x": 80,
      "y": 780
    },
    {
      "id": "n_put",
      "type": "send_operation",
      "label": "放下后部箱子",
      "params": {
        "call_type": "service",
        "service": "robot_task",
        "robot_id": "robot_a",
        "task": "put_down_box",
        "area": "outbound_shelf",
        "timeout": 1200
      },
      "x": 360,
      "y": 780
    },
    {
      "id": "n_nav_wait",
      "type": "navigate",
      "label": "去搬箱等待区",
      "params": {
        "robot_id": "robot_a",
        "pose": "box_wait",
        "skip_if_at_pose": true,
        "timeout": 180
      },
      "x": 640,
      "y": 780
    },
    {
      "id": "n_free",
      "type": "const_stations_all_free",
      "label": "全部工位待装表?",
      "params": {},
      "x": 920,
      "y": 780
    },
    {
      "id": "n_free_delay",
      "type": "delay",
      "label": "工位未全部空闲",
      "params": {
        "seconds": 5
      },
      "x": 920,
      "y": 960
    }
  ],
